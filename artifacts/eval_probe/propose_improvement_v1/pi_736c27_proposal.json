{
  "model": {
    "type": "transformer_lm",
    "vocab_size": 32,
    "context_length": 16,
    "d_model": 128,
    "num_layers": 1,
    "num_heads": 4,
    "d_ff": 128
  },
  "optimizer": {
    "type": "RMSprop",
    "lr": 0.0003,
    "weight_decay": 0.001
  },
  "loss": {
    "loss_id": "cross_entropy"
  },
  "budget": {
    "batch_size": 64
  }
}
