{
  "schema_version": "1.0",
  "contract_id": "wide_v2_supplemental_reserve_v1",
  "purpose": "Label-blind, pre-frozen capacity rescue for wide-v2 B2 exports whose original reserve is insufficient.",
  "base_plan": "tools/meta_model_dataset/plan_wide_v2.json",
  "supplemental_plan": "tools/meta_model_dataset/plan_wide_v2_supplemental_reserve_v1.json",
  "freeze_contract": "data/meta_model/setting_to_loss_wide_v2/supplemental_reserve_freeze_v1.json",
  "base_output_root": "data/meta_model/setting_to_loss_wide_v2",
  "supplemental_output_root": "data/meta_model/setting_to_loss_wide_v2_supplemental_reserve_v1",
  "merged_output_root": "data/meta_model/setting_to_loss_wide_v2_extended_v1",
  "scope": {
    "phase": "b2_scale",
    "experiments": 21,
    "selected_per_experiment": 50,
    "train_per_experiment": 45,
    "validation_per_experiment": 5,
    "internal_reserve_per_experiment": 17
  },
  "seed_derivation": {
    "algorithm": "int(sha256(base_plan_sha256 + ':' + contract_id + ':' + experiment_id + ':' + purpose)[:16], 16) mod 2147483647; map zero to one",
    "purposes": ["sampling", "split"],
    "time_dependent": false
  },
  "activation": {
    "exception_type": "RuntimeError",
    "message_prefix": "Not enough usable reserve settings to replace ",
    "requires_base_only_canonical_selection_failure": true,
    "successful_base_exports_immutable": true,
    "new_sampling_after_freeze_allowed": false
  },
  "selection": {
    "canonical_function": "tools.meta_model_dataset.core.select_usable_rows",
    "replacement_order": [
      "same_split_and_stratum",
      "same_split"
    ],
    "base_reserve_precedes_supplemental_reserve": true,
    "cross_split_allowed": false,
    "permitted_label_gate": "usable_for_regression only",
    "forbidden_selection_fields": [
      "target.mean_loss",
      "target.log_mean_loss",
      "target.std_loss",
      "target.benchmark_eligible",
      "loss magnitude",
      "loss rank"
    ]
  },
  "ground_truth": {
    "canonical_path": "sample_candidate -> write_candidate -> run_ground_truth -> results/summary.json",
    "merge_generates_ground_truth": false
  }
}
